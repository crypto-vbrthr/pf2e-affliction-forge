<section class="affliction-editor" data-affliction-editor-surface>
  <fieldset class="affliction-editor-fieldset" data-affliction-editor-fieldset>
    <section class="affliction-editor-section">
      <header class="affliction-editor-section-header">
        <div>
          <h2>{{localize "PF2E_AFFLICTION_FORGE.Editor.BasicData"}}</h2>
          <p>{{localize "PF2E_AFFLICTION_FORGE.Editor.BasicDataHint"}}</p>
        </div>
        <span class="affliction-editor-mode">{{mode}}</span>
      </header>

      <label class="affliction-editor-field full-width">
        <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.Id"}}</span>
        <input data-affliction-field="id" type="text" value="{{definition.id}}" required>
      </label>

      <div class="affliction-editor-name-image-row">
        <label class="affliction-editor-field">
          <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.Name"}}</span>
          <input data-affliction-field="name" type="text" value="{{definition.name}}" required>
        </label>

        <div class="affliction-editor-field affliction-editor-image-field">
          <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.Image"}}</span>
          <div class="affliction-editor-image-picker">
            <img src="{{definition.img}}" alt="">
            <input data-affliction-field="img" type="text" value="{{definition.img}}">
            <button type="button" data-affliction-action="browseImage" title="{{localize 'PF2E_AFFLICTION_FORGE.Editor.SelectImage'}}">
              <i class="fa-solid fa-ellipsis"></i>
            </button>
          </div>
        </div>
      </div>

      <div class="affliction-editor-grid four-columns">
        <label class="affliction-editor-field">
          <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.Type"}}</span>
          <select data-affliction-field="afflictionType">
            {{#each typeOptions as |option|}}
              <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
            {{/each}}
          </select>
        </label>

        <label class="affliction-editor-field">
          <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.Level"}}</span>
          <input data-affliction-field="level" type="number" min="0" max="25" step="1" value="{{definition.level}}">
        </label>

        <label class="affliction-editor-field">
          <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.Rarity"}}</span>
          <select data-affliction-field="rarity">
            {{#each rarityOptions as |option|}}
              <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
            {{/each}}
          </select>
        </label>

        <label class="affliction-editor-field">
          <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.Traits"}}</span>
          <input data-affliction-field="traits" type="text" value="{{definition.traits}}" placeholder="disease, magical">
        </label>
      </div>

      <label class="affliction-editor-field full-width">
        <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.Themes"}}</span>
        <input data-affliction-field="themes" type="text" value="{{definition.themes}}" placeholder="undead, decay">
        <small>{{localize "PF2E_AFFLICTION_FORGE.Editor.ListHint"}}</small>
      </label>

      <div class="affliction-editor-delivery-options" data-poison-delivery-options {{#unless isPoison}}hidden{{/unless}}>
        <label class="affliction-editor-checkbox">
          <input data-affliction-field="injuryPoison" type="checkbox" {{#if injuryPoison}}checked{{/if}}>
          <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.InjuryPoison"}}</span>
        </label>
        <small>{{localize "PF2E_AFFLICTION_FORGE.Editor.InjuryPoisonHint"}}</small>
      </div>

      <label class="affliction-editor-field full-width">
        <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.Description"}}</span>
        <textarea data-affliction-field="description" rows="4">{{definition.description}}</textarea>
      </label>
    </section>

    <section class="affliction-editor-section affliction-editor-identification-section">
      <header class="affliction-editor-section-header">
        <div>
          <h2>{{localize "PF2E_AFFLICTION_FORGE.Editor.Identification"}}</h2>
          <p>{{localize "PF2E_AFFLICTION_FORGE.Editor.IdentificationHint"}}</p>
        </div>
      </header>
      <div class="affliction-editor-grid two-columns">
        <label class="affliction-editor-field">
          <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.InitialIdentificationState"}}</span>
          <select data-affliction-field="identificationInitialState">
            {{#each identificationOptions as |option|}}
              <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
            {{/each}}
          </select>
        </label>
        <div class="affliction-editor-identification-summary">
          <strong>{{localize "PF2E_AFFLICTION_FORGE.Editor.IdentificationRuntimeHintTitle"}}</strong>
          <small>{{localize "PF2E_AFFLICTION_FORGE.Editor.IdentificationRuntimeHint"}}</small>
        </div>
      </div>
    </section>

    <section class="affliction-editor-section">
      <header class="affliction-editor-section-header">
        <div>
          <h2>{{localize "PF2E_AFFLICTION_FORGE.Editor.SaveChecks"}}</h2>
          <p>{{localize "PF2E_AFFLICTION_FORGE.Editor.SaveChecksHint"}}</p>
        </div>
        <button type="button" class="affliction-editor-primary" data-affliction-action="addCheck">
          <i class="fa-solid fa-plus"></i>
          {{localize "PF2E_AFFLICTION_FORGE.Editor.AddCheck"}}
        </button>
      </header>

      <div class="affliction-editor-policy-defaults">
        <div>
          <strong>{{localize "PF2E_AFFLICTION_FORGE.Editor.SavePolicyDefaults"}}</strong>
          <small>{{localize "PF2E_AFFLICTION_FORGE.Editor.SavePolicyDefaultsHint"}}</small>
        </div>
        <div class="affliction-editor-grid two-columns">
          <label class="affliction-editor-field">
            <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.SaveExecution"}}</span>
            <select data-affliction-field="saveDefaultExecution">
              {{#each saveDefaults.executionOptions as |option|}}
                <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
              {{/each}}
            </select>
          </label>
          <label class="affliction-editor-field">
            <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.SaveVisibility"}}</span>
            <select data-affliction-field="saveDefaultVisibility">
              {{#each saveDefaults.visibilityOptions as |option|}}
                <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
              {{/each}}
            </select>
          </label>
        </div>
      </div>

      <div class="affliction-editor-check-list">
        {{#each checks as |check|}}
          <article class="affliction-editor-check-card" data-affliction-check-index="{{check.index}}">
            <header>
              <strong>{{localize "PF2E_AFFLICTION_FORGE.Editor.Check"}} {{check.number}}</strong>
              <button type="button" class="icon danger" data-affliction-action="removeCheck" data-index="{{check.index}}" {{#unless check.canRemove}}disabled{{/unless}} title="{{localize 'PF2E_AFFLICTION_FORGE.Editor.RemoveCheck'}}">
                <i class="fa-solid fa-trash"></i>
              </button>
            </header>
            <div class="affliction-editor-grid five-columns">
              <label class="affliction-editor-field">
                <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.CheckId"}}</span>
                <input data-check-field="id" type="text" value="{{check.id}}" required>
              </label>
              <label class="affliction-editor-field">
                <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.CheckLabel"}}</span>
                <input data-check-field="label" type="text" value="{{check.label}}">
              </label>
              <label class="affliction-editor-field">
                <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.SaveStatistic"}}</span>
                <select data-check-field="statistic">
                  {{#each check.statisticOptions as |option|}}
                    <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                  {{/each}}
                </select>
              </label>
              <label class="affliction-editor-field">
                <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.DCMode"}}</span>
                <select data-check-field="dcMode">
                  {{#each check.dcModeOptions as |option|}}
                    <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                  {{/each}}
                </select>
              </label>
              <label class="affliction-editor-field">
                <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.DC"}}</span>
                <input data-check-field="dc" type="number" min="1" max="100" step="1" value="{{check.dc}}" {{#if check.sourceDc}}disabled{{/if}}>
                {{#if check.sourceDc}}<small>{{localize "PF2E_AFFLICTION_FORGE.Editor.DCSourceHint"}}</small>{{/if}}
              </label>
            </div>

            <div class="affliction-editor-check-policy" data-check-policy>
              <label class="affliction-editor-checkbox">
                <input data-check-policy-override type="checkbox" {{#unless check.policyView.inherited}}checked{{/unless}}>
                <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.OverrideSavePolicy"}}</span>
              </label>
              <small>{{localize "PF2E_AFFLICTION_FORGE.Editor.OverrideSavePolicyHint"}}</small>
              <div class="affliction-editor-grid two-columns affliction-editor-policy-grid">
                <label class="affliction-editor-field">
                  <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.SaveExecution"}}</span>
                  <select data-check-policy-control data-check-policy-execution>
                    {{#each check.policyView.executionOptions as |option|}}
                      <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                    {{/each}}
                  </select>
                </label>
                <label class="affliction-editor-field">
                  <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.SaveVisibility"}}</span>
                  <select data-check-policy-control data-check-policy-visibility>
                    {{#each check.policyView.visibilityOptions as |option|}}
                      <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                    {{/each}}
                  </select>
                </label>
              </div>
            </div>
          </article>
        {{/each}}
      </div>
    </section>

    <section class="affliction-editor-section">
      <header class="affliction-editor-section-header">
        <div>
          <h2>{{localize "PF2E_AFFLICTION_FORGE.Editor.Exposure"}}</h2>
          <p>{{localize "PF2E_AFFLICTION_FORGE.Editor.ExposureHint"}}</p>
        </div>
        <button type="button" data-affliction-action="toggleInitialCheck">
          {{#if hasInitialCheck}}
            <i class="fa-solid fa-toggle-on"></i> {{localize "PF2E_AFFLICTION_FORGE.Editor.DisableInitialCheck"}}
          {{else}}
            <i class="fa-solid fa-toggle-off"></i> {{localize "PF2E_AFFLICTION_FORGE.Editor.EnableInitialCheck"}}
          {{/if}}
        </button>
      </header>

      {{#if hasInitialCheck}}
        <div class="affliction-editor-gate" data-check-gate="initialCheck">
          <div class="affliction-editor-gate-head">
            <div class="affliction-editor-field">
              <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.UsedChecks"}}</span>
              <div class="affliction-editor-check-pills">
                {{#each initialCheck.checkOptions as |option|}}
                  <label data-gate-check-option data-check-index="{{option.index}}"><input data-gate-check-id type="checkbox" value="{{option.value}}" {{#if option.checked}}checked{{/if}}> <span data-gate-check-label>{{option.label}}</span></label>
                {{/each}}
              </div>
            </div>
            <label class="affliction-editor-field">
              <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.Combine"}}</span>
              <select data-gate-combine>
                {{#each initialCheck.combineOptions as |option|}}
                  <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                {{/each}}
              </select>
            </label>
          </div>
          <div class="affliction-editor-outcome-grid">
            {{#each initialCheck.outcomes as |outcome|}}
              <div class="affliction-editor-outcome" data-outcome="{{outcome.key}}">
                <strong>{{outcome.label}}</strong>
                <select data-directive-action>
                  {{#each outcome.directive.actionOptions as |option|}}
                    <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                  {{/each}}
                </select>
                <label data-directive-value-wrap {{#unless outcome.directive.usesValue}}hidden{{/unless}}>
                  <span data-directive-value-label>{{outcome.directive.valueLabel}}</span>
                  <input data-directive-value type="number" step="1" value="{{outcome.directive.value}}">
                </label>
              </div>
            {{/each}}
          </div>
        </div>
      {{else}}
        <p class="affliction-editor-empty">{{localize "PF2E_AFFLICTION_FORGE.Editor.NoInitialCheck"}}</p>
      {{/if}}

      <div class="affliction-editor-grid two-columns affliction-editor-duration-row">
        <div class="affliction-editor-duration-card" data-affliction-duration="onset">
          <label class="affliction-editor-checkbox">
            <input data-duration-enabled type="checkbox" {{#if onset.enabled}}checked{{/if}}>
            <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.Onset"}}</span>
          </label>
          <div class="affliction-editor-grid two-columns">
            <label class="affliction-editor-field">
              <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.DurationValue"}}</span>
              <input data-duration-control data-duration-value type="number" min="1" step="1" value="{{onset.value}}">
            </label>
            <label class="affliction-editor-field">
              <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.DurationUnit"}}</span>
              <select data-duration-control data-duration-unit>
                {{#each onset.unitOptions as |option|}}
                  <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                {{/each}}
              </select>
            </label>
          </div>
        </div>

        <div class="affliction-editor-duration-card" data-affliction-duration="maximumDuration">
          <div class="affliction-editor-duration-title">
            <label class="affliction-editor-checkbox">
              <input data-duration-enabled type="checkbox" {{#if maximumDuration.enabled}}checked{{/if}}>
              <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.MaximumDuration"}}</span>
            </label>
            <label class="affliction-editor-checkbox compact">
              <input data-duration-unlimited type="checkbox" {{#if maximumDuration.unlimited}}checked{{/if}}>
              <span>{{localize "PF2E_AFFLICTION_FORGE.Duration.Unlimited"}}</span>
            </label>
          </div>
          <div class="affliction-editor-grid two-columns">
            <label class="affliction-editor-field">
              <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.DurationValue"}}</span>
              <input data-duration-control data-duration-value type="number" min="1" step="1" value="{{maximumDuration.value}}">
            </label>
            <label class="affliction-editor-field">
              <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.DurationUnit"}}</span>
              <select data-duration-control data-duration-unit>
                {{#each maximumDuration.unitOptions as |option|}}
                  <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                {{/each}}
              </select>
            </label>
          </div>
          <p class="affliction-editor-duration-hint"><i class="fa-solid fa-clock"></i> {{localize "PF2E_AFFLICTION_FORGE.Editor.MaximumDurationHint"}}</p>
        </div>
      </div>
    </section>

    <section class="affliction-editor-section affliction-editor-restrictions-section" data-affliction-restrictions="root">
      <header class="affliction-editor-section-header">
        <div>
          <h2>{{localize "PF2E_AFFLICTION_FORGE.Restrictions.Title"}}</h2>
          <p>{{localize "PF2E_AFFLICTION_FORGE.Restrictions.RootHint"}}</p>
        </div>
      </header>
      <div class="affliction-editor-grid two-columns">
        <label class="affliction-editor-field">
          <span>{{localize "PF2E_AFFLICTION_FORGE.Restrictions.ConditionLocks"}}</span>
          <input data-restriction-field="conditionLocks" type="text" value="{{restrictionView.conditionLocksText}}" placeholder="sickened:1, fatigued">
          <small>{{localize "PF2E_AFFLICTION_FORGE.Restrictions.ConditionLocksHint"}}</small>
        </label>
        <label class="affliction-editor-field">
          <span>{{localize "PF2E_AFFLICTION_FORGE.Restrictions.Healing"}}</span>
          <select data-restriction-field="healing">
            {{#each restrictionView.healingOptions as |option|}}
              <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
            {{/each}}
          </select>
          <small>{{localize "PF2E_AFFLICTION_FORGE.Restrictions.HealingHint"}}</small>
        </label>
      </div>
      <div class="affliction-editor-grid two-columns">
        <label class="affliction-editor-field">
          <span>{{localize "PF2E_AFFLICTION_FORGE.Restrictions.UnhealableDamageTypes"}}</span>
          <input data-restriction-field="unhealableDamageTypes" type="text" value="{{restrictionView.unhealableDamageTypesText}}" placeholder="cold, fire">
          <small>{{localize "PF2E_AFFLICTION_FORGE.Restrictions.UnhealableDamageTypesHint"}}</small>
        </label>
        <label class="affliction-editor-checkbox">
          <input data-restriction-field="speak" type="checkbox" {{#if restrictionView.speakBlocked}}checked{{/if}}>
          <span>{{localize "PF2E_AFFLICTION_FORGE.Restrictions.CannotSpeak"}}</span>
        </label>
      </div>
    </section>

    <section class="affliction-editor-section">
      <header class="affliction-editor-section-header">
        <div>
          <h2>{{localize "PF2E_AFFLICTION_FORGE.Editor.StageProgression"}}</h2>
          <p>{{localize "PF2E_AFFLICTION_FORGE.Editor.StageProgressionHint"}}</p>
        </div>
        <button type="button" data-affliction-action="toggleDefaultStageCheck">
          {{#if hasDefaultStageCheck}}
            <i class="fa-solid fa-toggle-on"></i> {{localize "PF2E_AFFLICTION_FORGE.Editor.DisableStageCheck"}}
          {{else}}
            <i class="fa-solid fa-toggle-off"></i> {{localize "PF2E_AFFLICTION_FORGE.Editor.EnableStageCheck"}}
          {{/if}}
        </button>
      </header>

      {{#if hasDefaultStageCheck}}
        <div class="affliction-editor-gate" data-check-gate="defaultStageCheck">
          <div class="affliction-editor-gate-head">
            <div class="affliction-editor-field">
              <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.UsedChecks"}}</span>
              <div class="affliction-editor-check-pills">
                {{#each defaultStageCheck.checkOptions as |option|}}
                  <label data-gate-check-option data-check-index="{{option.index}}"><input data-gate-check-id type="checkbox" value="{{option.value}}" {{#if option.checked}}checked{{/if}}> <span data-gate-check-label>{{option.label}}</span></label>
                {{/each}}
              </div>
            </div>
            <label class="affliction-editor-field">
              <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.Combine"}}</span>
              <select data-gate-combine>
                {{#each defaultStageCheck.combineOptions as |option|}}
                  <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                {{/each}}
              </select>
            </label>
          </div>
          <div class="affliction-editor-outcome-grid">
            {{#each defaultStageCheck.outcomes as |outcome|}}
              <div class="affliction-editor-outcome" data-outcome="{{outcome.key}}">
                <strong>{{outcome.label}}</strong>
                <select data-directive-action>
                  {{#each outcome.directive.actionOptions as |option|}}
                    <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                  {{/each}}
                </select>
                <label data-directive-value-wrap {{#unless outcome.directive.usesValue}}hidden{{/unless}}>
                  <span data-directive-value-label>{{outcome.directive.valueLabel}}</span>
                  <input data-directive-value type="number" step="1" value="{{outcome.directive.value}}">
                </label>
              </div>
            {{/each}}
          </div>
        </div>
      {{else}}
        <p class="affliction-editor-empty">{{localize "PF2E_AFFLICTION_FORGE.Editor.NoDefaultStageCheck"}}</p>
      {{/if}}

      <div class="affliction-editor-delivery-options">
        <label class="affliction-editor-checkbox">
          <input data-affliction-field="virulent" type="checkbox" {{#if definition.progression.virulent}}checked{{/if}}>
          <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.Virulent"}}</span>
        </label>
        <small>{{localize "PF2E_AFFLICTION_FORGE.Editor.VirulentHint"}}</small>
      </div>

      <div class="affliction-editor-grid two-columns affliction-editor-progression-boundaries">
        <label class="affliction-editor-field">
          <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.BelowStageOne"}}</span>
          <select data-affliction-field="belowStageOne">
            <option value="recover" {{#if (eq definition.progression.belowStageOne "recover")}}selected{{/if}}>{{localize "PF2E_AFFLICTION_FORGE.Editor.Recover"}}</option>
            <option value="clamp" {{#if (eq definition.progression.belowStageOne "clamp")}}selected{{/if}}>{{localize "PF2E_AFFLICTION_FORGE.Editor.Clamp"}}</option>
          </select>
        </label>
        <label class="affliction-editor-field">
          <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.AboveMaximumStage"}}</span>
          <select data-affliction-field="aboveMaximumStage">
            <option value="clamp" {{#if (eq definition.progression.aboveMaximumStage "clamp")}}selected{{/if}}>{{localize "PF2E_AFFLICTION_FORGE.Editor.Clamp"}}</option>
            <option value="end" {{#if (eq definition.progression.aboveMaximumStage "end")}}selected{{/if}}>{{localize "PF2E_AFFLICTION_FORGE.Editor.EndAffliction"}}</option>
          </select>
        </label>
      </div>
    </section>

    <section class="affliction-editor-section affliction-editor-stages-section">
      <header class="affliction-editor-section-header">
        <div>
          <h2>{{localize "PF2E_AFFLICTION_FORGE.Editor.Stages"}}</h2>
          <p>{{localize "PF2E_AFFLICTION_FORGE.Editor.StagesHint"}}</p>
        </div>
        <button type="button" class="affliction-editor-primary" data-affliction-action="addStage">
          <i class="fa-solid fa-plus"></i>
          {{localize "PF2E_AFFLICTION_FORGE.Editor.AddStage"}}
        </button>
      </header>

      <div class="affliction-editor-stage-list">
        {{#each stages as |stage|}}
          <article class="affliction-editor-stage-card {{#if stage.collapsed}}collapsed{{/if}}" data-affliction-stage-index="{{stage.index}}">
            <header class="affliction-editor-stage-header">
              <button type="button" class="affliction-editor-stage-toggle" data-affliction-action="toggleStage" data-index="{{stage.index}}">
                <i class="fa-solid {{#if stage.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i>
                <strong>{{localize "PF2E_AFFLICTION_FORGE.Editor.Stage"}} {{stage.number}}{{#if stage.name}}: {{stage.name}}{{/if}}</strong>
              </button>
              <div class="affliction-editor-stage-actions">
                <button type="button" class="icon" data-affliction-action="moveStageUp" data-index="{{stage.index}}" {{#unless stage.canMoveUp}}disabled{{/unless}} title="{{localize 'PF2E_AFFLICTION_FORGE.Editor.MoveUp'}}"><i class="fa-solid fa-arrow-up"></i></button>
                <button type="button" class="icon" data-affliction-action="moveStageDown" data-index="{{stage.index}}" {{#unless stage.canMoveDown}}disabled{{/unless}} title="{{localize 'PF2E_AFFLICTION_FORGE.Editor.MoveDown'}}"><i class="fa-solid fa-arrow-down"></i></button>
