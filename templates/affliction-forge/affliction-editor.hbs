        {{/each}}
      </div>
    </section>

    <section class="affliction-editor-section affliction-editor-validation-section" data-validation-root>
      <header class="affliction-editor-section-header">
        <div>
          <h2>{{localize "PF2E_AFFLICTION_FORGE.Editor.Validation"}}</h2>
          <p>{{localize "PF2E_AFFLICTION_FORGE.Editor.ValidationHint"}}</p>
        </div>
        {{#if validation.valid}}
          <span class="affliction-editor-validation-badge valid" data-validation-badge><i class="fa-solid fa-circle-check"></i> {{localize "PF2E_AFFLICTION_FORGE.Editor.Valid"}}</span>
        {{else}}
          <span class="affliction-editor-validation-badge invalid" data-validation-badge><i class="fa-solid fa-circle-xmark"></i> {{validation.errorCount}} {{localize "PF2E_AFFLICTION_FORGE.Editor.Errors"}}</span>
        {{/if}}
      </header>
      {{#if validation.issues.length}}
        <div class="affliction-editor-issues" data-validation-issues>
          {{#each validation.issues as |issue|}}
            <div class="affliction-editor-issue severity-{{issue.severity}}">
              <i class="fa-solid {{#if (eq issue.severity 'error')}}fa-circle-xmark{{else}}fa-triangle-exclamation{{/if}}"></i>
              <span><strong>{{issue.path}}</strong> {{issue.displayMessage}}</span>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="affliction-editor-empty" data-validation-issues>{{localize "PF2E_AFFLICTION_FORGE.Editor.NoValidationIssues"}}</p>
      {{/if}}
    </section>
  </fieldset>
</section>
