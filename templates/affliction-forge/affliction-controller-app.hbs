<div class="affliction-controller-shell">
  <header class="affliction-controller-identity">
    <img src="{{img}}" alt="">
    <div>
      <h2>{{name}}</h2>
      <div class="affliction-controller-subtitle">
        <span><i class="fa-solid fa-user-shield"></i> {{actorName}}</span>
        <span>{{statusLabel}}</span>
      </div>
    </div>
  </header>

  <section class="affliction-controller-stage">
    <div class="affliction-controller-stage-summary">
      <div>
        <small>{{localize "PF2E_AFFLICTION_FORGE.Runtime.CurrentStage"}}</small>
        <strong>{{stageLabel}}</strong>
      </div>
      <div>
        <small>{{localize "PF2E_AFFLICTION_FORGE.Runtime.ActiveEffects"}}</small>
        <strong>{{activeEffectCount}}</strong>
      </div>
      <div>
        <small>{{localize "PF2E_AFFLICTION_FORGE.Runtime.Revision"}}</small>
        <strong>{{state.revision}}</strong>
      </div>
    </div>

    <div class="affliction-controller-stage-actions">
      <button type="button" data-action="previousStage" {{#unless canPrevious}}disabled{{/unless}}>
        <i class="fa-solid fa-arrow-left"></i>
        {{localize "PF2E_AFFLICTION_FORGE.Runtime.PreviousStage"}}
      </button>
      <button type="button" data-action="reapplyStage" {{#unless canReapply}}disabled{{/unless}}>
        <i class="fa-solid fa-rotate"></i>
        {{localize "PF2E_AFFLICTION_FORGE.Runtime.ReapplyStage"}}
      </button>
      <button type="button" data-action="nextStage" {{#unless canNext}}disabled{{/unless}}>
        {{localize "PF2E_AFFLICTION_FORGE.Runtime.NextStage"}}
        <i class="fa-solid fa-arrow-right"></i>
      </button>
    </div>
  </section>

  <section class="affliction-controller-checks">
    <div class="affliction-controller-stage-summary">
      <div>
        <small>{{localize "PF2E_AFFLICTION_FORGE.Runtime.NextCheck"}}</small>
        <strong>{{dueLabel}}</strong>
      </div>
      <div>
        <small>{{localize "PF2E_AFFLICTION_FORGE.Runtime.PendingChecks"}}</small>
        <strong>{{#if pendingSummary}}{{pendingSummary}}{{else}}—{{/if}}</strong>
      </div>
      <div>
        <small>{{localize "PF2E_AFFLICTION_FORGE.Runtime.LastCheck"}}</small>
        <strong>{{lastCheckLabel}}</strong>
      </div>
    </div>
    <div class="affliction-controller-check-actions">
      <button type="button" data-action="processCheck" {{#unless canProcess}}disabled{{/unless}}>
        <i class="fa-solid fa-dice-d20"></i>
        {{processLabel}}
      </button>
      <button type="button" data-action="reconcileRuntime">
        <i class="fa-solid fa-screwdriver-wrench"></i>
        {{localize "PF2E_AFFLICTION_FORGE.Runtime.Reconcile"}}
      </button>
      {{#if canResume}}
      <button type="button" data-action="resumeAffliction">
        <i class="fa-solid fa-play"></i>
        {{localize "PF2E_AFFLICTION_FORGE.Runtime.Resume"}}
      </button>
      {{else}}
      <button type="button" data-action="pauseAffliction" {{#unless canPause}}disabled{{/unless}}>
        <i class="fa-solid fa-pause"></i>
        {{localize "PF2E_AFFLICTION_FORGE.Runtime.Pause"}}
      </button>
      {{/if}}
    </div>
  </section>

  {{#if periodicEffects.length}}
  <section class="affliction-controller-restrictions affliction-controller-periodic">
    <header><strong><i class="fa-solid fa-clock-rotate-left"></i> {{localize "PF2E_AFFLICTION_FORGE.Periodic.ActiveTitle"}}</strong></header>
    {{#each periodicEffects as |periodic|}}
      <div>
        <small>{{periodic.label}}</small>
        <strong>{{periodic.dueLabel}}</strong>
        <span> · {{localize "PF2E_AFFLICTION_FORGE.Periodic.Executions"}}: {{periodic.sequence}}</span>
      </div>
    {{/each}}
  </section>
  {{/if}}

  <section class="affliction-controller-identification">
    <label>
      <span>{{localize "PF2E_AFFLICTION_FORGE.Editor.Identification"}}</span>
      <select data-affliction-identification>
        {{#each identificationStates as |entry|}}
          <option value="{{entry.value}}" {{#if entry.selected}}selected{{/if}}>{{entry.label}}</option>
        {{/each}}
      </select>
    </label>
    <button type="button" data-action="setIdentification">
      <i class="fa-solid fa-eye"></i>
      {{localize "PF2E_AFFLICTION_FORGE.Runtime.ApplyIdentification"}}
    </button>
  </section>


  {{#if restrictions.hasAny}}
  <section class="affliction-controller-restrictions">
    <header><strong><i class="fa-solid fa-shield-virus"></i> {{localize "PF2E_AFFLICTION_FORGE.Restrictions.ActiveTitle"}}</strong></header>
    {{#if restrictions.conditionLocks.length}}
      <div><small>{{localize "PF2E_AFFLICTION_FORGE.Restrictions.ConditionLocks"}}</small> <strong>{{restrictions.conditionLocks}}</strong></div>
    {{/if}}
    <div><small>{{localize "PF2E_AFFLICTION_FORGE.Restrictions.Healing"}}</small> <strong>{{restrictions.healingLabel}}</strong>{{#if restrictions.unhealableDamage}} · {{restrictions.unhealableDamage}} TP{{/if}}</div>
    {{#if restrictions.unhealableDamageTypes.length}}
      <div><small>{{localize "PF2E_AFFLICTION_FORGE.Restrictions.UnhealableDamageTypes"}}</small> <strong>{{restrictions.unhealableDamageTypes}}</strong>{{#if restrictions.unhealableDamageByType.length}} · {{restrictions.unhealableDamageByType}}{{/if}}</div>
    {{/if}}
    {{#if restrictions.blocksSpeak}}
      <div><strong>{{localize "PF2E_AFFLICTION_FORGE.Restrictions.CannotSpeak"}}</strong></div>
    {{/if}}
  </section>
  {{/if}}

  {{#if mortality}}
  <section class="affliction-controller-mortality">
    <div class="affliction-controller-mortality-icon"><i class="fa-solid fa-skull"></i></div>
    <div>
      <small>{{localize "PF2E_AFFLICTION_FORGE.Runtime.DeathCause"}}</small>
      <strong>{{mortality.stageLabel}}</strong>
      <span>{{mortality.categoryLabel}}{{#if mortality.ageLabel}} · {{mortality.ageLabel}}{{/if}}</span>
    </div>
  </section>
  {{/if}}

  <section class="affliction-controller-events">
    <header>
      <strong>{{localize "PF2E_AFFLICTION_FORGE.Runtime.EventLog"}}</strong>
      <small>{{localize "PF2E_AFFLICTION_FORGE.Runtime.EventLogHint"}}</small>
    </header>
    {{#if runtimeEvents.length}}
      <ol>
        {{#each runtimeEvents as |event|}}
          <li class="{{#if event.important}}important{{/if}} {{#if event.lethal}}lethal{{/if}}">
            <span>{{event.label}}</span>
            <small>{{event.ageLabel}}</small>
          </li>
        {{/each}}
      </ol>
    {{else}}
      <p class="affliction-controller-events-empty">{{localize "PF2E_AFFLICTION_FORGE.Runtime.EventLogEmpty"}}</p>
    {{/if}}
  </section>

  <footer class="affliction-controller-footer">
    <div class="affliction-controller-source">
      {{#if sourceTemplateUuid}}
        <small>{{localize "PF2E_AFFLICTION_FORGE.Runtime.SourceTemplate"}}: {{sourceTemplateUuid}}</small>
      {{else}}
        <small>{{localize "PF2E_AFFLICTION_FORGE.Runtime.SourceDraft"}}</small>
      {{/if}}
    </div>
    <button type="button" class="danger" data-action="endAffliction">
      <i class="fa-solid fa-skull-crossbones"></i>
      {{localize "PF2E_AFFLICTION_FORGE.Runtime.EndAffliction"}}
    </button>
  </footer>
</div>
